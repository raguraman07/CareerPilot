# ==============================================================================
# CareerPilot AI — Backend Environment Configuration Example
# ==============================================================================
# Copy this template to .env for local development or configure these variables
# in your Render Dashboard (Settings -> Environment Variables) for production.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Allowed Frontend Origins for CORS (Comma-separated)
# For local dev: http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# For production: https://YOUR-CAREERPILOT-FRONTEND.vercel.app
FRONTEND_ORIGIN=https://YOUR-CAREERPILOT-FRONTEND.vercel.app,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Google Gemini API Key (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Firebase Admin SDK Credentials
# Option 1 (Render Production): Paste entire content of serviceAccountKey.json as single-line string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"careerpilot-4e3a5",...}
# Option 2 (Local Development): Path relative to backend directory
FIREBASE_SERVICE_ACCOUNT_JSON=firebase/serviceAccountKey.json

# Adzuna Jobs API Credentials (Backend Only)
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
ADZUNA_COUNTRY=in
