# ==============================================================================
# CareerPilot AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure real values. NEVER commit .env to Git.
# ==============================================================================

# Flask Server Configuration
PORT=5000
FLASK_APP=app.py
FLASK_ENV=production
FRONTEND_ORIGIN=https://your-careerpilot-frontend.vercel.app

# Firebase Admin SDK Configuration
# Option 1: File path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=backend/firebase/serviceAccountKey.json

# Option 2: Full JSON string in environment variable (Recommended for Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 3: Individual Environment Variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Adzuna Jobs API Configuration (Job Opportunities Module)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in
